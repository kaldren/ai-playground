# Aspire Dashboard OTLP/gRPC endpoint exposed by docker-compose.yml.
TELEMETRY_EXPORTER=aspire
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Deployed environments default to Application Insights when this is set.
# To test it locally, set TELEMETRY_EXPORTER=applicationinsights and provide
# the connection string in your private .env file.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
# OTEL_EXPERIMENTAL_RESOURCE_DETECTORS=otel

# Override this per example so each one is easy to identify in the dashboard.
OTEL_SERVICE_NAME=ai-playground-python

# Agent Framework instrumentation is enabled by default. Leave message content
# disabled unless you explicitly want prompts, responses, and tool arguments sent.
ENABLE_SENSITIVE_DATA=false

# Remote Microsoft Learn MCP server used by the documentation agent example.
MCP_NAME=Microsoft Learn MCP
MCP_URL=https://learn.microsoft.com/api/mcp
