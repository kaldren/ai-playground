# Aspire Dashboard OTLP/gRPC endpoint exposed by docker-compose.yml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Override this per example so each one is easy to identify in the dashboard.
OTEL_SERVICE_NAME=ai-playground-python

# Agent Framework instrumentation is enabled by default. Leave message content
# disabled unless you explicitly want prompts, responses, and tool arguments sent.
ENABLE_SENSITIVE_DATA=false

